#!/bin/bash

# ccs - AI service client selector with configuration files
# Similar to qw but uses .conf files for different AI providers

# Function to display help
show_help() {
    cat << EOF
ccs - AI service client selector with configuration files

Usage: ccs [config_name] [options]

Configuration:
  config_name    Name of the configuration file (without .conf extension)
                 Looks for ~/.aiconf/<config_name>.conf

  No arguments   Show this help message

Configuration file format (~/.aiconf/<name>.conf):
  api_key=<your_api_key>
  claude_url=<claude_api_base_url>
  openai_url=<openai_api_base_url>
  model=<model_name>

Environment variables (fallback):
  ANTHROPIC_AUTH_TOKEN  API key
  ANTHROPIC_BASE_URL    Base URL

Examples:
  ccs              Show this help message
  ccs k2           Use k2.conf configuration
  ccs myai         Use myai.conf configuration
  ccs --help       Show this help message

Configuration files should be placed in ~/.aiconf/
EOF
}

# Function to show version
show_version() {
    claude --version
}

# Function to read configuration file
read_config() {
    local config_name="$1"
    local config_file="$HOME/.aiconf/${config_name}.conf"

    if [[ ! -f "$config_file" ]]; then
        echo "Error: Configuration file not found: $config_file" >&2
        return 1
    fi

    # Read configuration file
    local api_key=""
    local claude_url=""
    local openai_url=""
    local model=""

    while IFS='=' read -r key value; do
        # Skip comments and empty lines
        [[ $key =~ ^#.* ]] && continue
        [[ -z $key ]] && continue

        # Remove surrounding quotes and spaces\n        value=$(echo \"$value\" | sed 's/^[\"'\\'' ]*//; s/[\"'\\'' ]*$//')

        case "$key" in
            "api_key")
                api_key="$value"
                ;;
            "claude_url")
                claude_url="$value"
                ;;
            "openai_url")
                openai_url="$value"
                ;;
            "model")
                model="$value"
                ;;
        esac
    done < "$config_file"

    # Set environment variables
    if [[ -n "$api_key" ]]; then
        # export ANTHROPIC_AUTH_TOKEN=$api_key
        export ANTHROPIC_API_KEY="$api_key"
    fi

    if [[ -n "$claude_url" ]]; then
        export ANTHROPIC_BASE_URL="$claude_url"
    fi

    # Note: ccs uses claude_url, but we still read openai_url for compatibility
    # with qw script which uses openai_url

    if [[ -n "$model" ]]; then
        export ANTHROPIC_MODEL="$model"
    fi

    echo "Using configuration: $config_name"
    echo "  API Key: ${api_key:0:8}..."
    echo "  Claude URL: $claude_url"
    echo "  Model: $model"
}

# Parse command line arguments
case "${1:-}" in
    "-h"|"--help"|"")
        show_help
        exit 0
        ;;
    "-v"|"--version")
        show_version
        exit 0
        ;;
    *)
        # Treat as configuration name
        CONFIG_NAME="$1"
        shift
        ;;
esac

# Check if configuration name is provided
if [[ -z "$CONFIG_NAME" ]]; then
    show_help
    exit 0
fi

# Create config directory if it doesn't exist
mkdir -p "$HOME/.aiconf"

# Read configuration
read_config "$CONFIG_NAME"

# Add bun to PATH if available
if [ -d "$HOME/.bun/bin" ]; then
    export PATH="$HOME/.bun/bin:$PATH"
fi

# Execute claude with remaining arguments
if command -v claude >/dev/null 2>&1; then
    claude "$@"
elif command -v claude.exe >/dev/null 2>&1; then
    claude.exe "$@"
else
    echo "Error: claude executable not found in PATH" >&2
    exit 1
fi
