#!/bin/bash

# qw - AI service client selector with configuration files
# Similar to ccs but uses .conf files for different AI providers

# Function to display help
show_help() {
    echo "qw - Qwen Code AI service selector with configuration files"
    echo ""
    echo "Usage: qw [config_name] [options]"
    echo ""
    echo "Configuration:"
    echo "  config_name    Name of the configuration file (without .conf extension)"
    echo "                 Looks for ~/.aiconf/<config_name>.conf"
    echo ""
    echo "  No arguments   Show this help message"
    echo ""
    echo "Configuration file format (~/.aiconf/<name>.conf):"
    echo "  api_key=<your_api_key>"
    echo "  base_url=<api_base_url>"
    echo "  model=<model_name>"
    echo ""
    echo "Environment variables (fallback):"
    echo "  OPENAI_KEY      API key"
    echo "  OPENAI_URL      Base URL"
    echo "  OPENAI_MODEL    Model name"
    echo ""
    echo "Examples:"
    echo "  qw              Show this help message"
    if [[ -d "$HOME/.aiconf" ]]; then
        for conf_file in "$HOME/.aiconf"/*.conf; do
            if [[ -e "$conf_file" ]]; then
                basename_conf=$(basename "$conf_file" .conf)
                # Extract the first line comment from the config file
                first_line_comment=$(head -n 1 "$conf_file" | grep '^#' | sed 's/^# *//' | head -c 60)
                if [[ -n "$first_line_comment" ]]; then
                    printf "  qw %-12s %s\n" "$basename_conf" "$first_line_comment"
                else
                    printf "  qw %-12s Use %s.conf configuration\n" "$basename_conf" "$basename_conf"
                fi
            fi
        done
    fi
    echo "  qw --help       Show this help message"
    echo ""
    echo "Configuration files should be placed in ~/.aiconf/"
}

# Function to show version
show_version() {
    qwen -v
}

# Function to read configuration file
read_config() {
    local config_name="$1"
    local config_file="$HOME/.aiconf/${config_name}.conf"

    if [[ ! -f "$config_file" ]]; then
        echo "Error: Configuration file not found: $config_file" >&2
        return 1
    fi

    # Read configuration file
    local api_key=""
    local base_url=""
    local model=""

    while IFS='=' read -r key value; do
        # Skip comments and empty lines
        [[ $key =~ ^#.* ]] && continue
        [[ -z $key ]] && continue

        # Remove surrounding quotes and spaces
        value=$(echo "$value" | sed 's/^["'\'' ]*//; s/["'\'' ]*$//')

        case "$key" in
            "api_key")
                api_key="$value"
                ;;
            "base_url")
                base_url="$value"
                ;;
            "model")
                model="$value"
                ;;
        esac
    done < "$config_file"

    # Set environment variables
    if [[ -n "$api_key" ]]; then
        export OPENAI_API_KEY="$api_key"
    fi

    if [[ -n "$base_url" ]]; then
        export OPENAI_BASE_URL="$base_url"
    fi

    if [[ -n "$model" ]]; then
        export OPENAI_MODEL="$model"
    fi

    echo "Using configuration: $config_name"
    echo "  API Key: ${api_key:0:8}..."
    echo "  Base URL: $base_url"
    echo "  Model: $model"
}

# Parse command line arguments
case "${1:-}" in
    ""|"-h"|"--help")
        show_help
        exit 0
        ;;
    "-v"|"--version")
        show_version
        exit 0
        ;;
    *)
        # Treat as configuration name
        CONFIG_NAME="$1"
        shift
        ;;
esac

# Check if configuration name is provided
if [[ -z "$CONFIG_NAME" ]]; then
    show_help
    exit 0
fi

# Create config directory if it doesn't exist
mkdir -p "$HOME/.aiconf"

# Read configuration
read_config "$CONFIG_NAME"

# Check if qwen executable exists
if command -v qwen >/dev/null 2>&1; then
    qwen "$@"
elif command -v qwen.exe >/dev/null 2>&1; then
    qwen.exe "$@"
else
    echo "Error: qwen executable not found in PATH" >&2
    exit 1
fi
